# Financial Dashboard — Environment Variables
# Copie este arquivo para .env e ajuste os valores para seu ambiente.
# NUNCA commite o arquivo .env (contém segredos).

# === Banco de Dados ===
DATABASE_URL=postgres://user:pass@localhost:5433/financial_dashboard?sslmode=disable

# === JWT (constitution P-IV — RBAC deny-by-default) ===
# JWT_SECRET: mínimo 32 caracteres em produção
JWT_SECRET=change-me-in-production-min-32-chars

# TTLs de token (task 0.5.1 — CHK002)
# access_token=15min  (stateless, renovado via refresh)
# refresh_token=7dias (revogável via blocklist — CHK011)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# === Servidor HTTP ===
SERVER_PORT=8080

# === TLS (obrigatório em produção — CHK025) ===
# Deixe em branco para HTTP (desenvolvimento local apenas).
# Em produção: forneça certificado válido (Let's Encrypt recomendado).
TLS_CERT_PATH=
TLS_KEY_PATH=
